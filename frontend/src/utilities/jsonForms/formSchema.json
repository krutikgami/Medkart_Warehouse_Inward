{
  "fieldType": "div",
  "style": {
    "display": "flex",
    "justifyContent": "center",
    "alignItems": "center",
    "minHeight": "100vh",
    "background": "#f9f9f9"
  },
  "children": [
    {
      "fieldType": "div",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "1rem",
        "border": "1px solid #ccc",
        "margin": "2rem",
        "padding": "2rem",
        "borderRadius": "8px",
        "width": "auto",
        "background": "#fff",
        "boxShadow": "0 2px 8px rgba(0,0,0,0.1)"
      },
      "children": [
        {
          "fieldType": "div",
          "style": {
            "display": "flex",
            "gap": "1rem",
            "width": "100%"
          },
          "children": [
            {
              "fieldType": "input",
              "label": "First Name",
              "name": "firstName",
              "type": "text",
              "style": {
                "flex": "1",
                "minWidth": "0",
                "padding": "8px",
                "border": "1px solid #ccc",
                "borderRadius": "4px"
              },
              "validations": {
                "required": { "value": true, "message": "First name is required" },
                "minLength": { "value": 2, "message": "Must be at least 2 characters" }
              }
            },
            {
              "fieldType": "input",
              "label": "Middle Name",
              "name": "middleName",
              "type": "text",
              "style": {
                "flex": "1",
                "minWidth": "0",
                "padding": "8px",
                "border": "1px solid #ccc",
                "borderRadius": "4px"
              },
              "validations": {
                "required": { "value": true, "message": "Middle name is required" },
                "minLength": { "value": 2, "message": "Must be at least 2 characters" }
              }
            },
            {
              "fieldType": "input",
              "label": "Last Name",
              "name": "lastName",
              "type": "text",
              "style": {
                "flex": "1",
                "minWidth": "0",
                "padding": "8px",
                "border": "1px solid #ccc",
                "borderRadius": "4px"
              },
              "validations": {
                "required": { "value": true, "message": "Last name is required" }
              }
            }
          ]
        },
        {
          "fieldType": "input",
          "label": "Email",
          "name": "email",
          "type": "email",
          "style": {
            "width": "250px",
            "padding": "8px",
            "border": "1px solid #ccc",
            "borderRadius": "4px"
          },
          "validations": {
            "required": { "value": true, "message": "Email is required" },
            "pattern": {
              "value": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "message": "Invalid email format"
            }
          }
        },
        {
          "fieldType": "div",
          "style": {
            "display": "flex",
            "gap": "1rem",
            "justifyContent": "flex-end",
            "marginTop": "1rem",
            "width": "100%"
          },
          "children": [
            {
              "fieldType": "button",
              "label": "Submit",
              "name": "submit",
              "type": "submit",
              "style": {
                "flex": "1",
                "padding": "10px 20px",
                "background": "blue",
                "color": "white",
                "border": "none",
                "borderRadius": "4px",
                "cursor": "pointer"
              },
              "validations": { "formCheck": true }
            },
            {
              "fieldType": "button",
              "label": "Cancel",
              "name": "cancel",
              "type": "button",
              "style": {
                "flex": "1",
                "padding": "10px 20px",
                "background": "gray",
                "color": "white",
                "border": "none",
                "borderRadius": "4px",
                "cursor": "pointer"
              },
              "validations": { "action": "reset" }
            }
          ]
        }
      ]
    }
  ]
}
